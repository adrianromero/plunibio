{
    "name": "plunibio",
    "version": "0.1.2",
    "description": "A lightweight desktop Markdown editor built with Tauri and SolidJS.",
    "type": "module",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "notices": "node scripts/generate-third-party-notices.mjs",
        "release:check": "node scripts/check-release-version.mjs",
        "automation:build": "VITE_PLUNIBIO_AUTOMATION=1 npm run tauri build -- --debug --no-bundle --features automation --config src-tauri/tauri.automation.conf.json",
        "automation:run": "tsx automation/run.ts",
        "check": "tsc --noEmit && tsc --noEmit -p .storybook/tsconfig.json",
        "serve": "vite preview",
        "test": "vitest run",
        "tauri": "tauri"
    },
    "author": "Adrián Romero",
    "license": "MIT",
    "dependencies": {
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.4",
        "@codemirror/legacy-modes": "^6.5.4",
        "@codemirror/search": "^6.7.2",
        "@codemirror/view": "^6.43.12",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/literata": "^5.3.0",
        "@fontsource-variable/open-sans": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.1",
        "@lezer/highlight": "^1.2.5",
        "@milkdown/crepe": "7.21.2",
        "@milkdown/kit": "7.21.2",
        "@solid-primitives/i18n": "^2.2.1",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
        "@tauri-apps/plugin-opener": "^2",
        "codemirror": "^6.0.2",
        "lucide-solid": "^1.47.0",
        "mermaid": "^12.2.0",
        "prosemirror-search": "^1.1.1",
        "solid-js": "^1.9.17"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@tauri-apps/cli": "2.12.4",
        "@types/node": "^26.6.5",
        "@wdio/cli": "^9.32.0",
        "@wdio/globals": "^9.31.3",
        "@wdio/local-runner": "^9.32.0",
        "@wdio/mocha-framework": "^9.32.0",
        "@wdio/spec-reporter": "^9.32.0",
        "@wdio/tauri-plugin": "^1.5.1",
        "@wdio/tauri-service": "^1.5.1",
        "jsdom": "^28.1.0",
        "storybook": "^10.6.5",
        "storybook-solidjs-vite": "^10.7.2",
        "tsx": "^4.23.15",
        "typescript": "~5.6.2",
        "vite": "^6.4.5",
        "vite-plugin-solid": "^2.11.0",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "dompurify": "3.4.17",
        "katex": "0.19.1",
        "prosemirror-model": "1.25.9",
        "prosemirror-view": "1.42.8",
        "vue": "3.5.44"
    }
}
