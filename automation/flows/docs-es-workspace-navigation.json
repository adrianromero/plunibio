{
    "name": "Docs ES: espacios y archivos",
    "app": {
        "basePath": "examples/atlas-de-lumina",
        "fixtureTimestamp": "2026-10-01T12:00:00Z",
        "workspaceMode": "temporary-copy",
        "preferences": {
            "folderSort": { "attribute": "name", "direction": "asc" },
            "locale": "es",
            "theme": "light",
            "typography": "sans-serif",
            "sidebarVisible": false,
            "showHiddenFiles": false
        },
        "file": "README.md",
        "width": 1024,
        "height": 768
    },
    "outputDir": "website/assets/images/docs/es/workspaces-and-files",
    "settleMs": 500,
    "steps": [
        {
            "action": "wait",
            "target": { "using": "css", "value": "html[lang='es']" },
            "state": "existing"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='breadcrumb-segment'][data-path='']"
            }
        },
        {
            "action": "wait",
            "target": { "using": "testId", "value": "folder-view" },
            "state": "visible"
        },
        {
            "action": "capture",
            "scope": "viewport",
            "name": "workspace-root"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='folder-entry'][data-path='notes']"
            }
        },
        {
            "action": "wait",
            "target": { "using": "testId", "value": "file-breadcrumb" },
            "state": "visible",
            "text": "notes"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='folder-entry'][data-path='notes/notas-de-campo.md']"
            }
        },
        {
            "action": "wait",
            "target": { "using": "testId", "value": "markdown-editor" },
            "state": "visible"
        },
        {
            "action": "wait",
            "target": { "using": "testId", "value": "file-breadcrumb" },
            "state": "visible",
            "text": "notas-de-campo.md"
        },
        {
            "action": "capture",
            "scope": "viewport",
            "name": "nested-file"
        },
        {
            "action": "click",
            "target": { "using": "aria", "value": "Más opciones" }
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-toolbar-menu-entry='open-workspace']"
            }
        },
        {
            "action": "wait",
            "target": { "using": "testId", "value": "workspace-dialog" },
            "state": "visible"
        },
        {
            "action": "click",
            "target": { "using": "aria", "value": "Ubicaciones del equipo" }
        },
        {
            "action": "wait",
            "target": { "using": "testId", "value": "workspace-directory" },
            "state": "visible"
        },
        {
            "action": "capture",
            "scope": "element",
            "target": { "using": "testId", "value": "workspace-dialog" },
            "name": "workspace-selector"
        }
    ]
}
