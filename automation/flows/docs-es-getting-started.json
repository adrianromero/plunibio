{
    "name": "Docs ES: primeros pasos y primer documento",
    "app": {
        "basePath": "examples/atlas-de-lumina",
        "fixtureTimestamp": "2026-10-01T12:00:00Z",
        "workspaceMode": "temporary-copy",
        "preferences": {
            "folderSort": {
                "attribute": "name",
                "direction": "asc"
            },
            "locale": "es",
            "theme": "light",
            "typography": "sans-serif",
            "sidebarVisible": true,
            "showHiddenFiles": false
        },
        "file": "README.md",
        "width": 1024,
        "height": 768
    },
    "outputDir": "website/assets/images/docs/es/getting-started",
    "settleMs": 500,
    "steps": [
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "html[lang='es']"
            },
            "state": "existing"
        },
        {
            "action": "wait",
            "target": {
                "using": "testId",
                "value": "markdown-editor"
            },
            "state": "visible"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='markdown-editor'] h1"
            },
            "state": "visible",
            "text": "Atlas de Lúmina"
        },
        {
            "action": "capture",
            "scope": "viewport",
            "name": "main-interface"
        },
        {
            "action": "click",
            "target": {
                "using": "aria",
                "value": "Más opciones"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='toolbar-menu'][aria-label='Más opciones']"
            },
            "state": "visible"
        },
        {
            "action": "capture",
            "scope": "viewport",
            "name": "general-menu"
        },
        {
            "action": "click",
            "target": {
                "using": "aria",
                "value": "Más opciones"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='toolbar-menu'][aria-label='Más opciones']"
            },
            "state": "hidden"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='breadcrumb-segment'][data-path='']"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "testId",
                "value": "folder-view"
            },
            "state": "visible"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-create-kind='markdown']"
            },
            "state": "enabled"
        },
        {
            "action": "capture",
            "scope": "viewport",
            "name": "folder-actions"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-create-kind='markdown']"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "testId",
                "value": "create-entry-dialog"
            },
            "state": "visible"
        },
        {
            "action": "keys",
            "keys": [
                "mi-primera-nota"
            ]
        },
        {
            "action": "capture",
            "scope": "element",
            "target": {
                "using": "testId",
                "value": "create-entry-dialog"
            },
            "name": "create-document"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='create-entry-dialog'] button[type='submit']"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "testId",
                "value": "file-breadcrumb"
            },
            "state": "visible",
            "text": "mi-primera-nota.md"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='markdown-editor'] .ProseMirror[contenteditable='true']"
            },
            "state": "visible"
        },
        {
            "action": "caret",
            "target": {
                "using": "css",
                "value": "[data-testid='markdown-editor'] .ProseMirror > p:last-child"
            },
            "position": "end"
        },
        {
            "action": "keys",
            "keys": [
                "Esta es mi primera nota en Plunibio",
                "Decimal"
            ]
        },
        {
            "action": "wait",
            "target": {
                "using": "aria",
                "value": "Cambios sin guardar"
            },
            "state": "visible"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='markdown-editor'] .ProseMirror"
            },
            "state": "visible",
            "text": "Esta es mi primera nota en Plunibio."
        },
        {
            "action": "capture",
            "scope": "viewport",
            "name": "first-document-unsaved"
        },
        {
            "action": "keys",
            "keys": [
                "Control",
                "s"
            ]
        },
        {
            "action": "wait",
            "target": {
                "using": "aria",
                "value": "Cambios sin guardar"
            },
            "state": "missing"
        },
        {
            "action": "keys",
            "keys": [
                "Control",
                "r"
            ]
        },
        {
            "action": "wait",
            "target": {
                "using": "testId",
                "value": "message-dialog"
            },
            "state": "visible"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog'] button:first-child"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='markdown-editor'] .ProseMirror"
            },
            "state": "visible",
            "text": "Esta es mi primera nota en Plunibio."
        },
        {
            "action": "wait",
            "target": {
                "using": "aria",
                "value": "Cambios sin guardar"
            },
            "state": "missing"
        }
    ]
}
