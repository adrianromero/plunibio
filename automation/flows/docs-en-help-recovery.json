{
    "name": "Docs EN: recover from navigation save failure",
    "app": {
        "basePath": "examples/plunibio-docs-lab",
        "workspaceMode": "temporary-copy",
        "fixtureTimestamp": "2026-10-01T12:00:00Z",
        "file": "images/editor/image-lab.bmp",
        "width": 1024,
        "height": 768,
        "preferences": {
            "locale": "en",
            "theme": "light",
            "typography": "sans-serif",
            "sidebarVisible": true,
            "showHiddenFiles": false,
            "folderSort": {
                "attribute": "name",
                "direction": "asc"
            }
        }
    },
    "outputDir": "website/assets/images/docs/en/shortcuts-troubleshooting",
    "settleMs": 500,
    "steps": [
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='image-canvas'][width='1200'][height='500']"
            },
            "state": "existing"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='image-action'][data-action='rotate-right']"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "aria",
                "value": "Unsaved changes"
            }
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='breadcrumb-segment'][data-path='images/editor']"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog']"
            },
            "state": "visible",
            "text": "If you continue, your data might be lost."
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog'] button:first-child"
            },
            "state": "visible",
            "text": "Continue"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog'] button:last-child"
            },
            "state": "visible",
            "text": "Cancel"
        },
        {
            "action": "capture",
            "scope": "element",
            "target": {
                "using": "testId",
                "value": "message-dialog"
            },
            "name": "navigation-save-failed"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog'] button:last-child"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog']"
            },
            "state": "hidden"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='file-breadcrumb']"
            },
            "state": "visible",
            "text": "image-lab.bmp"
        },
        {
            "action": "wait",
            "target": {
                "using": "aria",
                "value": "Unsaved changes"
            }
        },
        {
            "action": "keys",
            "keys": [
                "Control",
                "r"
            ]
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog']"
            },
            "state": "visible",
            "text": "discard your unsaved changes"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='message-dialog'] button:first-child"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='image-canvas'][width='1200'][height='500']"
            },
            "state": "existing"
        },
        {
            "action": "wait",
            "target": {
                "using": "aria",
                "value": "Unsaved changes"
            },
            "state": "missing"
        },
        {
            "action": "click",
            "target": {
                "using": "css",
                "value": "[data-testid='breadcrumb-segment'][data-path='images/editor']"
            }
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='folder-view']"
            },
            "state": "visible"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-testid='folder-entry'][data-path='images/editor/image-lab.bmp']"
            },
            "state": "visible"
        }
    ]
}
