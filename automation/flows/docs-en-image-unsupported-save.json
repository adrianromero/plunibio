{
    "name": "Docs EN: unsupported edited-image save error",
    "app": {
        "basePath": "examples/plunibio-docs-lab",
        "workspaceMode": "temporary-copy",
        "preferences": {
            "locale": "en",
            "theme": "light",
            "sidebarVisible": true,
            "showHiddenFiles": false
        },
        "file": "images/editor/image-lab.bmp",
        "width": 1024,
        "height": 768
    },
    "outputDir": "website/assets/images/docs/en/view-edit-images",
    "settleMs": 500,
    "steps": [
        { "action": "wait", "target": { "using": "css", "value": "html[lang='en']" }, "state": "existing" },
        { "action": "wait", "target": { "using": "testId", "value": "image-view" }, "state": "visible" },
        { "action": "click", "target": { "using": "css", "value": "[data-testid='image-action'][data-action='rotate-right']" } },
        { "action": "wait", "target": { "using": "aria", "value": "Unsaved changes" }, "state": "visible" },
        { "action": "keys", "keys": ["Control", "s"] },
        { "action": "wait", "target": { "using": "testId", "value": "message-dialog" }, "state": "visible", "text": "This image format can be viewed but cannot be saved after editing. Saving is supported for PNG, JPEG, and WebP." },
        { "action": "capture", "scope": "element", "target": { "using": "testId", "value": "message-dialog" }, "name": "unsupported-image-save" },
        { "action": "click", "target": { "using": "css", "value": "[data-testid='message-dialog'] button:last-child" } },
        { "action": "wait", "target": { "using": "testId", "value": "message-dialog" }, "state": "hidden" },
        { "action": "wait", "target": { "using": "aria", "value": "Unsaved changes" }, "state": "visible" }
    ]
}
