{
    "name": "Print QA: mermaid from dark theme",
    "app": {
        "basePath": "automation/fixtures/printing",
        "workspaceMode": "temporary-copy",
        "file": "route.mmd",
        "width": 1024,
        "height": 768,
        "preferences": {
            "theme": "dark",
            "locale": "es",
            "typography": "sans-serif",
            "sidebarVisible": false
        }
    },
    "outputDir": "automation/output/printing",
    "timeoutMs": 20000,
    "steps": [
        {
            "action": "wait",
            "target": {
                "using": "testId",
                "value": "mermaid-view"
            },
            "state": "visible"
        },
        {
            "action": "wait",
            "target": {
                "using": "css",
                "value": "[data-toolbar-menu-entry=\"print\"]"
            },
            "state": "enabled"
        },
        {
            "action": "printPdf",
            "name": "mermaid",
            "containsText": [
                "Puerto Sereno",
                "Mercado de Cristal",
                "Archivo de Mareas"
            ]
        }
    ]
}
