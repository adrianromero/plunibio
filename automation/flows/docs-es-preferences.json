{
    "name": "Docs ES: personalizar y conservar preferencias",
    "app": {
        "basePath": "examples/plunibio-docs-lab",
        "workspaceMode": "read-only",
        "preferences": {
            "locale": "es",
            "theme": "light",
            "typography": "sans-serif",
            "sidebarVisible": true,
            "showHiddenFiles": false
        },
        "file": "markdown/editor-lab.es.md",
        "width": 1024,
        "height": 768
    },
    "outputDir": "website/assets/images/docs/es/customize",
    "settleMs": 500,
    "steps": [
        { "action": "wait", "target": { "using": "css", "value": "html[lang='es'][data-theme='light'][data-typography='sans-serif']" }, "state": "existing" },
        { "action": "wait", "target": { "using": "testId", "value": "markdown-editor" }, "state": "visible" },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "wait", "target": { "using": "testId", "value": "toolbar-menu" }, "state": "visible", "text": "General" },
        { "action": "wait", "target": { "using": "css", "value": "[data-toolbar-menu-entry='theme']" }, "state": "visible", "text": "Claro" },
        { "action": "wait", "target": { "using": "css", "value": "[data-toolbar-menu-entry='language']" }, "state": "visible", "text": "Español" },
        { "action": "wait", "target": { "using": "css", "value": "[data-toolbar-menu-entry='hidden-files']" }, "state": "visible", "text": "Ocultar" },
        { "action": "wait", "target": { "using": "css", "value": "[data-toolbar-menu-entry='typography']" }, "state": "visible", "text": "Sans Serif" },
        { "action": "capture", "scope": "viewport", "name": "preferences-menu" },

        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='language']" } },
        { "action": "wait", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma']" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma'] [data-choice-option='es'][aria-checked='true']" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma'] [data-choice-option='en']" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma'] [data-choice-option='ca']" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma'] [data-choice-option='gl']" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma'] [data-choice-option='eu']" }, "state": "visible" },
        { "action": "capture", "scope": "viewport", "name": "language-menu" },
        { "action": "click", "target": { "using": "css", "value": "[role='menu'][aria-label='Idioma'] [data-choice-option='es']" } },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='typography']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='reading']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[data-typography='reading']" }, "state": "existing" },
        { "action": "capture", "scope": "viewport", "name": "reading-typography" },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='typography']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='sans-serif']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[data-typography='sans-serif']" }, "state": "existing" },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='theme']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='dark']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[data-theme='dark']" }, "state": "existing" },
        { "action": "capture", "scope": "viewport", "name": "dark-theme" },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='typography']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='reading']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[data-typography='reading']" }, "state": "existing" },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='language']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='en']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[lang='en']" }, "state": "existing" },
        { "action": "refresh" },
        { "action": "wait", "target": { "using": "css", "value": "html[lang='en'][data-theme='dark'][data-typography='reading']" }, "state": "existing" },
        { "action": "wait", "target": { "using": "testId", "value": "markdown-editor" }, "state": "visible" },

        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='language']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='es']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[lang='es']" }, "state": "existing" },
        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='theme']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='light']" } },
        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='typography']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='sans-serif']" } },
        { "action": "wait", "target": { "using": "css", "value": "html[lang='es'][data-theme='light'][data-typography='sans-serif']" }, "state": "existing" },

        { "action": "click", "target": { "using": "css", "value": "[data-testid='breadcrumb-segment'][data-path='']" } },
        { "action": "wait", "target": { "using": "testId", "value": "folder-view" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[data-testid='folder-entry'][data-path='.hidden-note.md']" }, "state": "missing" },
        { "action": "capture", "scope": "viewport", "name": "hidden-files-before" },
        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='hidden-files']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='show']" } },
        { "action": "wait", "target": { "using": "css", "value": "[data-testid='folder-entry'][data-path='.hidden-note.md']" }, "state": "visible" },
        { "action": "wait", "target": { "using": "css", "value": "[data-testid='folder-entry'][data-path='.hidden-folder']" }, "state": "visible" },
        { "action": "capture", "scope": "viewport", "name": "hidden-files-after" },
        { "action": "refresh" },
        { "action": "wait", "target": { "using": "css", "value": "html[lang='es'][data-theme='light'][data-typography='sans-serif']" }, "state": "existing" },
        { "action": "wait", "target": { "using": "css", "value": "[data-testid='folder-entry'][data-path='.hidden-note.md']" }, "state": "visible" },
        { "action": "click", "target": { "using": "testId", "value": "toolbar-menu-trigger" } },
        { "action": "click", "target": { "using": "css", "value": "[data-toolbar-menu-entry='hidden-files']" } },
        { "action": "click", "target": { "using": "css", "value": "[data-choice-option='hide']" } },
        { "action": "wait", "target": { "using": "css", "value": "[data-testid='folder-entry'][data-path='.hidden-note.md']" }, "state": "missing" }
    ]
}
