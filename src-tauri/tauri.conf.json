{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Plunibio",
    "version": "0.1.2",
    "identifier": "com.adrian.plunibio",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Plunibio",
                "width": 800,
                "height": 600,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": null,
            "capabilities": ["default"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Productivity",
        "shortDescription": "A lightweight desktop Markdown editor.",
        "longDescription": "A lightweight desktop Markdown editor built with Tauri, SolidJS, and Milkdown Crepe.",
        "homepage": "https://github.com/adrianromero/plunibio",
        "publisher": "Adrián Romero",
        "copyright": "Copyright (c) 2026 Adrián Romero",
        "license": "MIT",
        "licenseFile": "../LICENSE",
        "resources": {
            "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
